# MongoDB Atlas connection string. Use "mongomock://" for an in-memory dev database
# (needs `pip install -r requirements-dev.txt`; data is lost on restart).
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=easyhand

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated emails of moderators (can review reports, hide listings, ban accounts)
ADMIN_EMAILS=

# Comma-separated, e.g. https://easyhand.vercel.app,http://localhost:8081
CORS_ORIGINS=*

# Public web address of the app (no trailing slash). Used for links in emails.
APP_URL=http://localhost:8081

# Email via https://resend.com. Leave RESEND_API_KEY empty to print emails in the server log instead.
# EMAIL_FROM must use a domain you verified in Resend (onboarding@resend.dev only reaches your own inbox).
RESEND_API_KEY=
EMAIL_FROM=EasyHand <hello@your-domain.com>

# Optional: error tracking with https://sentry.io (free tier). Leave empty to turn off.
SENTRY_DSN=
ENVIRONMENT=development

# Optional: enables photo uploads on listings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=easyhand
